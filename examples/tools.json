{
  "search_documents": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "top_k": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "language": {
        "enum": [
          "en",
          "fa"
        ]
      }
    },
    "required": [
      "query",
      "top_k"
    ],
    "additionalProperties": false
  }
}
